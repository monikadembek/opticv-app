# Template for apps/opticv-be/config/env/{development,staging,production}.env
#
# Copy this file to `development.env` (and `staging.env` / `production.env` as
# needed) and fill in the values. The real files are gitignored — this template
# is the only copy in version control, so keep it in sync when adding a new
# variable. `config/validation.ts` is the source of truth: a missing required
# key makes the app fail to boot with a Joi "Config validation error".
#
# Loaded by NODE_ENV: ConfigModule picks config/env/${NODE_ENV}.env at Nest
# bootstrap, and prisma.config.ts loads the same file for Prisma CLI usage.

NODE_ENV=development
PORT=3000

# Supabase — Project Settings > API
# Development and staging may share one project; production has its own.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — bucket + API token credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

OPENAI_API_KEY=

# Redis (Upstash) — REDIS_PASSWORD is optional, REDIS_TLS=true for Upstash
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
BULLMQ_CONCURRENCY=5

# Drives CORS in main.ts — the origin the frontend is served from
FRONTEND_URL=http://localhost:4200

# Stripe — use test-mode keys/prices outside production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Rate limiting (optional — these are the defaults)
# THROTTLER_API_IP_TTL=900
# THROTTLER_API_IP_LIMIT=300
# THROTTLER_API_USER_TTL=900
# THROTTLER_API_USER_LIMIT=100
# THROTTLER_AI_IP_TTL=3600
# THROTTLER_AI_IP_LIMIT=50
# THROTTLER_AI_USER_TTL=3600
# THROTTLER_AI_USER_LIMIT=10

# Prisma (read directly by prisma.config.ts and PrismaService)
# Supabase > Project Settings > Database > Connection string.
# DATABASE_URL is the pooled connection (port 6543, pgbouncer=true);
# DIRECT_URL is the direct one (port 5432) and is what migrations use.
DATABASE_URL=
DIRECT_URL=
