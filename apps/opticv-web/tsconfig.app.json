{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "src",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "moduleResolution": "bundler",
    "module": "preserve"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/shared/datatypes/tsconfig.lib.json"
    }
  ]
}
